{
  "name": "ordem-servico-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue.bold,green.bold\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:all": "bun run dev",
    "dev:server": "bun run --cwd server dev",
    "dev:client": "bun run --cwd client dev",
    "build:server": "bun run --cwd server build",
    "build:client": "bun run --cwd client build",
    "build": "bun run build:server && bun run build:client",
    "typecheck:server": "bun run --cwd server typecheck",
    "typecheck:client": "bun run --cwd client typecheck",
    "typecheck": "bun run typecheck:server && bun run typecheck:client",
    "test:server": "bun run --cwd server test",
    "test": "bun run test:server",
    "seed:server": "bun run --cwd server seed",
    "prisma:migrate": "bun run --cwd server prisma:migrate",
    "prisma:generate": "bun run --cwd server prisma:generate",
    "prisma:seed": "bun run --cwd server seed",
    "prisma:studio": "bun run --cwd server prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
