generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modelo de verificação inicial para validação da conectividade e migrações (ELI-8)
model AppHealth {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
  status    String   @default("UP")
}

model Customer {
  id         String      @id @default(uuid())
  name       String
  document   String      @unique
  email      String
  phone      String
  address    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workOrders WorkOrder[]
  quotes     Quote[]
  invoices   Invoice[]

  @@map("customers")
}

model Technician {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  phone      String
  specialty  String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workOrders WorkOrder[]
  quotes     Quote[]

  @@map("technicians")
}

model WorkOrder {
  id                 String    @id @default(uuid())
  orderNumber        String    @unique
  customerId         String
  technicianId       String?
  equipment          String
  serialNumber       String?
  reportedDefect     String
  technicalDiagnosis String?
  status             String    @default("OPEN")
  priority           String    @default("MEDIUM")
  totalServices      Float     @default(0.0)
  totalParts         Float     @default(0.0)
  discount           Float     @default(0.0)
  totalAmount        Float     @default(0.0)
  scheduledDate      DateTime?
  completedDate      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician Technician?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  quote      Quote?
  items      WorkOrderItem[]
  logs       WorkOrderLog[]
  attachments WorkOrderAttachment[]
  stockMovements StockMovement[]
  invoices   Invoice[]

  @@index([customerId])
  @@index([technicianId])
  @@index([status])
  @@index([priority])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String   @id @default(uuid())
  workOrderId String
  productId   String?  // Chave estrangeira opcional para controle de estoque
  type        String   // "SERVICE" | "PART"
  description String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0.0)
  subtotal    Float    @default(0.0)

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([productId])
  @@map("work_order_items")
}

model Product {
  id           String          @id @default(uuid())
  sku          String          @unique
  name         String
  description  String?
  unit         String          @default("UN")
  costPrice    Float           @default(0.0)
  salePrice    Float           @default(0.0)
  currentStock Int             @default(0)
  minStock     Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  movements    StockMovement[]
  orderItems   WorkOrderItem[]
  quoteItems   QuoteItem[]

  @@map("products")
}

model StockMovement {
  id          String     @id @default(uuid())
  productId   String
  workOrderId String?
  type        String     // "IN" | "OUT" | "ADJUSTMENT"
  quantity    Int
  unitPrice   Float?     // Valor de custo ou referência na movimentação
  reason      String     // Motivo da movimentação (ex.: Fornecedor, OS-2026-0001, Perda, Ajuste)
  createdBy   String     @default("SYSTEM")
  createdAt   DateTime   @default(now())

  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([workOrderId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model WorkOrderLog {
  id             String   @id @default(uuid())
  workOrderId    String
  previousStatus String?
  newStatus      String
  comment        String?
  createdBy      String   @default("SYSTEM")
  createdAt      DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_logs")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OPERATOR") // "ADMIN" | "OPERATOR"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Company {
  id             String   @id @default(uuid())
  name           String   // Razão Social
  tradeName      String   // Nome Fantasia
  cnpj           String   @unique
  ie             String?  // Inscrição Estadual (opcional)
  email          String
  phone          String
  address        String
  city           String
  state          String   // UF (2 caracteres)
  zipCode        String   // CEP
  logoUrl        String?
  warrantyTerms  String?  // Termos legais padrão de garantia
  workOrderNotes String?  // Observações e instruções padrão da OS
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("company")
}

model WorkOrderAttachment {
  id           String    @id @default(uuid())
  workOrderId  String
  fileName     String    // Nome sanitizado único gerado no disco (ex.: uuid.ext)
  originalName String    // Nome original do arquivo enviado pelo cliente
  mimeType     String    // image/jpeg, image/png, image/webp, application/pdf
  size         Int       // Tamanho em bytes
  url          String    // URL pública relativa (ex.: /uploads/work-orders/uuid.ext)
  type         String    @default("DOCUMENT") // "BEFORE" | "AFTER" | "DOCUMENT"
  uploadedBy   String    // Identificação do usuário autor do upload
  createdAt    DateTime  @default(now())

  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([type])
  @@map("work_order_attachments")
}

model Quote {
  id                 String    @id @default(uuid())
  quoteNumber        String    @unique
  customerId         String
  technicianId       String?
  equipment          String
  serialNumber       String?
  reportedDefect     String
  technicalDiagnosis String?
  status             String    @default("DRAFT") // "DRAFT" | "SENT" | "APPROVED" | "REJECTED" | "EXPIRED"
  notes              String?
  totalServices      Float     @default(0.0)
  totalParts         Float     @default(0.0)
  discount           Float     @default(0.0)
  totalAmount        Float     @default(0.0)
  validUntil         DateTime?
  workOrderId        String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  workOrder  WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  items      QuoteItem[]
  invoices   Invoice[]

  @@index([customerId])
  @@index([technicianId])
  @@index([status])
  @@index([validUntil])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  productId   String?  // Peça opcional do catálogo de estoque
  type        String   // "SERVICE" | "PART"
  description String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0.0)
  subtotal    Float    @default(0.0)

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  customerId    String
  workOrderId   String?
  quoteId       String?
  amount        Float     @default(0.0)
  discount      Float     @default(0.0)
  netAmount     Float     @default(0.0)
  paidAmount    Float     @default(0.0)
  status        String    @default("PENDING") // "PENDING" | "PARTIALLY_PAID" | "PAID" | "CANCELED"
  dueDate       DateTime
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  quote         Quote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  payments      Payment[]

  @@index([customerId])
  @@index([workOrderId])
  @@index([quoteId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Float
  paymentMethod String   // "PIX" | "CREDIT_CARD" | "DEBIT_CARD" | "CASH" | "BANK_SLIP"
  paidAt        DateTime @default(now())
  receivedBy    String   @default("SYSTEM")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([paidAt])
  @@map("payments")
}


